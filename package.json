{
  "name": "forgenv",
  "version": "1.0.1",
  "description": "Zero-config, type-safe environment variable validation and expansion engine",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/test"
  ],
  "bin": {
    "forgenv": "dist/cli/index.js"
  },
  "scripts": {
    "test": "npm run build && vitest run",
    "build": "tsc",
    "prepublishOnly": "npm run build && vitest run",
    "start": "ts-node index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FikerTaddev/forgenv.git"
  },
  "keywords": [
    "env",
    "dotenv",
    "environment",
    "validation",
    "type-safe",
    "schema",
    "config"
  ],
  "author": "FikerTaddev",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/FikerTaddev/forgenv/issues"
  },
  "homepage": "https://github.com/FikerTaddev/forgenv#readme",
  "dependencies": {
    "consola": "^3.4.2"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2",
    "vitest": "^4.1.2"
  }
}
